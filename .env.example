# Copy this file to `.env.local` for local development.
# Template consumers should replace placeholder branding and URLs before the first production deploy.

# Public runtime URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Public app metadata
NEXT_PUBLIC_APP_NAME=Next Admin Panel
NEXT_PUBLIC_APP_SHORT_NAME=Admin Panel
NEXT_PUBLIC_APP_DESCRIPTION=Production-ready Next.js admin panel boilerplate
NEXT_PUBLIC_APP_THEME_COLOR=#111827
NEXT_PUBLIC_APP_BACKGROUND_COLOR=#ffffff
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=false

# Public observability
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Server auth cookies
# Production deployments must set AUTH_COOKIE_SECURE=true.
# AUTH_COOKIE_SAME_SITE=none also requires AUTH_COOKIE_SECURE=true.
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_MAX_AGE_SECONDS=1800
AUTH_REFRESH_TOKEN_MAX_AGE_SECONDS=2592000

# Server observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# Tooling and local automation
OPENAPI_SCHEMA_URL=http://localhost:8000/schema/admin/openapi.json
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_WEB_SERVER_URL=http://localhost:3000
